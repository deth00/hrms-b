// Phase 1 — authentication, application users, roles, and permissions.
// Phase 2 — organization structure + position master data (Company,
// Branch, Department, Division, Unit, PositionLevel, Position).
// Still no Employee model — a Position/Unit/etc. is not yet held by
// anyone; that link is Phase 3+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           Int        @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId     String?    @unique @map("legacy_id")
  username     String     @unique
  email        String?    @unique
  displayName  String     @map("display_name")
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles              UserRole[]
  sessions           Session[]
  employee           Employee?
  assignmentsCreated EmployeeAssignmentHistory[]

  schedulesCreated EmployeeScheduleAssignment[] @relation("ScheduleCreatedBy")

  punchesCreated AttendancePunch[] @relation("PunchCreatedBy")

  correctionsRequested AttendanceCorrectionRequest[]     @relation("CorrectionRequestedBy")
  correctionsReviewed  AttendanceCorrectionRequest[]     @relation("CorrectionReviewedBy")
  correctionsApplied   AttendanceCorrectionApplication[] @relation("CorrectionAppliedBy")
  leaveBalancesCreated LeaveBalance[]                    @relation("LeaveBalanceCreatedBy")
  leaveBalancesUpdated LeaveBalance[]                    @relation("LeaveBalanceUpdatedBy")
  leaveAdjustments     LeaveBalanceAdjustment[]          @relation("LeaveAdjustmentCreatedBy")
  leaveRequested       LeaveRequest[]                    @relation("LeaveRequestedBy")
  leaveReviewed        LeaveRequest[]                    @relation("LeaveReviewedBy")
  overtimeRequested    OvertimeRequest[]                 @relation("OvertimeRequestedBy")
  overtimeReviewed     OvertimeRequest[]                 @relation("OvertimeReviewedBy")
  approvalSteps        ApprovalWorkflowStep[]            @relation("ApprovalStepUser")
  approvalRequested    ApprovalInstance[]                @relation("ApprovalRequester")
  approvalActed        ApprovalStepInstance[]            @relation("ApprovalStepActedBy")
  auditEvents          AuditEvent[]                      @relation("AuditActor")
  notifications        Notification[]
  savedReportFilters   SavedReportFilter[]

  compensationsCreated     EmployeeCompensation[]          @relation("CompensationCreatedBy")
  recurringPayCreated      EmployeeRecurringPayComponent[] @relation("RecurringPayCreatedBy")
  payrollPeriodsCreated    PayrollPeriod[]                 @relation("PayrollPeriodCreatedBy")
  payrollRunsCreated       PayrollRun[]                    @relation("PayrollRunCreatedBy")
  payrollRunsCalculated    PayrollRun[]                    @relation("PayrollRunCalculatedBy")
  payrollRunsFinalized     PayrollRun[]                    @relation("PayrollRunFinalizedBy")
  payrollRunsSubmitted     PayrollRun[]                    @relation("PayrollRunSubmittedBy")
  payrollRunsApproved      PayrollRun[]                    @relation("PayrollRunApprovedBy")
  payslipsIssued           Payslip[]                       @relation("PayslipIssuedBy")
  payrollAdjustments       PayrollManualAdjustment[]       @relation("PayrollAdjustmentCreatedBy")
  payrollSchedulesCreated  PayrollSchedule[]               @relation("PayrollScheduleCreatedBy")
  payrollRuleSetsCreated   PayrollRuleSet[]                @relation("PayrollRuleSetCreatedBy")
  approvalCandidates       ApprovalStepCandidate[]         @relation("ApprovalCandidate")
  statutoryRuleSetsCreated PayrollStatutoryRuleSet[]       @relation("StatutoryRuleSetCreatedBy")
  statutoryProfilesCreated EmployeeStatutoryProfile[]      @relation("StatutoryProfileCreatedBy")
  statutoryProfilesUpdated EmployeeStatutoryProfile[]      @relation("StatutoryProfileUpdatedBy")

  // Phase 14 - payment preparation
  paymentProfilesCreated  EmployeePaymentProfile[]       @relation("PaymentProfileCreatedBy")
  paymentProfilesUpdated  EmployeePaymentProfile[]       @relation("PaymentProfileUpdatedBy")
  bankAccountsCreated     EmployeeBankAccount[]          @relation("BankAccountCreatedBy")
  bankAccountsUpdated     EmployeeBankAccount[]          @relation("BankAccountUpdatedBy")
  paymentBatchesCreated   PayrollPaymentBatch[]          @relation("PaymentBatchCreatedBy")
  paymentBatchesValidated PayrollPaymentBatch[]          @relation("PaymentBatchValidatedBy")
  paymentBatchesExported  PayrollPaymentBatch[]          @relation("PaymentBatchExportedBy")
  paymentBatchesConfirmed PayrollPaymentBatch[]          @relation("PaymentBatchConfirmedBy")
  paymentBatchesCancelled PayrollPaymentBatch[]          @relation("PaymentBatchCancelledBy")
  paymentItemsConfirmed   PayrollPaymentItem[]           @relation("PaymentItemConfirmedBy")
  bankExportProfiles      BankExportProfile[]            @relation("BankExportProfileCreatedBy")
  paymentBatchExports     PaymentBatchExport[]           @relation("PaymentBatchExportCreatedBy")
  // Phase 15
  paymentItemsReconciled  PayrollPaymentItem[]           @relation("PaymentItemReconciledBy")
  paymentReversals        PayrollPaymentReversal[]       @relation("PaymentReversedBy")
  reconciliationProfiles  PaymentReconciliationProfile[] @relation("ReconciliationProfileCreatedBy")
  reconciliationsImported PaymentReconciliationImport[]  @relation("ReconciliationImportedBy")
  reconciliationsApplied  PaymentReconciliationImport[]  @relation("ReconciliationAppliedBy")
  reconciliationsCancel   PaymentReconciliationImport[]  @relation("ReconciliationCancelledBy")
  reconciliationRowsIgn   PaymentReconciliationRow[]     @relation("ReconciliationRowIgnoredBy")
  reconciliationRowsMatch PaymentReconciliationRow[]     @relation("ReconciliationRowMatchedBy")

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId    String?  @unique @map("legacy_id")
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users         UserRole[]
  permissions   RolePermission[]
  approvalSteps ApprovalWorkflowStep[] @relation("ApprovalStepRole")

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId    String?  @unique @map("legacy_id")
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       Int      @map("user_id")
  userIdLegacy String?  @map("user_id_legacy") @ignore
  roleId       Int      @map("role_id")
  roleIdLegacy String?  @map("role_id_legacy") @ignore
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId             Int      @map("role_id")
  roleIdLegacy       String?  @map("role_id_legacy") @ignore
  permissionId       Int      @map("permission_id")
  permissionIdLegacy String?  @map("permission_id_legacy") @ignore
  createdAt          DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id           Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId     String?   @unique @map("legacy_id")
  userId       Int       @map("user_id")
  userIdLegacy String?   @map("user_id_legacy") @ignore
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────
// Phase 2 — Organization structure + position master data
// ─────────────────────────────────────────────────────────────────

enum OrgStatus {
  ACTIVE
  INACTIVE
}

model Company {
  id                 Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId           String?   @unique @map("legacy_id")
  code               String    @unique
  nameLao            String    @map("name_lao")
  nameEnglish        String?   @map("name_english")
  taxNumber          String?   @map("tax_number")
  registrationNumber String?   @map("registration_number")
  phone              String?
  email              String?
  address            String?
  province           String?
  district           String?
  village            String?
  logoUrl            String?   @map("logo_url")
  status             OrgStatus @default(ACTIVE)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  branches          Branch[]
  departments       Department[]
  positionLevels    PositionLevel[]
  positions         Position[]
  employmentTypes   EmploymentType[]
  employees         Employee[]
  assignmentHistory EmployeeAssignmentHistory[]

  shifts   Shift[]
  holidays Holiday[]

  workLocations WorkLocation[]

  attendancePolicy  AttendancePolicy?
  leaveTypes        LeaveType[]
  overtimePolicy    OvertimePolicy?
  approvalWorkflows ApprovalWorkflow[]
  auditEvents       AuditEvent[]

  payrollSettings          PayrollSettings?
  payComponents            PayComponent[]
  payrollPeriods           PayrollPeriod[]
  payrollRuns              PayrollRun[]
  payrollSchedules         PayrollSchedule[]
  payrollRuleSets          PayrollRuleSet[]
  statutoryRuleSets        PayrollStatutoryRuleSet[]
  payslips                 Payslip[]
  bankAccounts             EmployeeBankAccount[]
  paymentBatches           PayrollPaymentBatch[]
  bankExportProfiles       BankExportProfile[]
  // Phase 15
  paymentReversals         PayrollPaymentReversal[]
  reconciliationProfiles   PaymentReconciliationProfile[]
  reconciliationImports    PaymentReconciliationImport[]
  // Phase 16
  glAccounts               GLAccount[]
  accountingRuleSets       PayrollAccountingRuleSet[]
  payrollJournals          PayrollJournal[]
  accountingExportProfiles AccountingExportProfile[]

  @@map("companies")
}

model Branch {
  id              Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId        String?   @unique @map("legacy_id")
  companyId       Int       @map("company_id")
  companyIdLegacy String?   @map("company_id_legacy") @ignore
  code            String
  nameLao         String    @map("name_lao")
  nameEnglish     String?   @map("name_english")
  phone           String?
  email           String?
  address         String?
  province        String?
  district        String?
  village         String?
  latitude        Float?
  longitude       Float?
  status          OrgStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments       Department[]
  employees         Employee[]
  assignmentHistory EmployeeAssignmentHistory[]

  workLocations WorkLocation[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

/// Branch is optional: a Department may sit directly under a Company, or
/// under one of its Branches. Code is unique per Company (not per Branch)
/// so a code unambiguously identifies one department across the whole
/// company regardless of which branch — or none — it belongs to.
model Department {
  id              Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId        String?   @unique @map("legacy_id")
  companyId       Int       @map("company_id")
  companyIdLegacy String?   @map("company_id_legacy") @ignore
  branchId        Int?      @map("branch_id")
  branchIdLegacy  String?   @map("branch_id_legacy") @ignore
  code            String
  nameLao         String    @map("name_lao")
  nameEnglish     String?   @map("name_english")
  description     String?
  status          OrgStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch            Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  divisions         Division[]
  units             Unit[]
  employees         Employee[]
  assignmentHistory EmployeeAssignmentHistory[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@map("departments")
}

model Division {
  id                 Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId           String?   @unique @map("legacy_id")
  departmentId       Int       @map("department_id")
  departmentIdLegacy String?   @map("department_id_legacy") @ignore
  code               String
  nameLao            String    @map("name_lao")
  nameEnglish        String?   @map("name_english")
  description        String?
  status             OrgStatus @default(ACTIVE)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  department        Department                  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  units             Unit[]
  employees         Employee[]
  assignmentHistory EmployeeAssignmentHistory[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("divisions")
}

/// Division is optional: a Unit may sit directly under a Department, or
/// under one of its Divisions. Code is unique per Department for the
/// same reason as Department.code is unique per Company.
model Unit {
  id                 Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId           String?   @unique @map("legacy_id")
  departmentId       Int       @map("department_id")
  departmentIdLegacy String?   @map("department_id_legacy") @ignore
  divisionId         Int?      @map("division_id")
  divisionIdLegacy   String?   @map("division_id_legacy") @ignore
  code               String
  nameLao            String    @map("name_lao")
  nameEnglish        String?   @map("name_english")
  description        String?
  status             OrgStatus @default(ACTIVE)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  department        Department                  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  division          Division?                   @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  employees         Employee[]
  assignmentHistory EmployeeAssignmentHistory[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@index([divisionId])
  @@map("units")
}

/// Master data only — no approval-routing behavior is attached to rank
/// yet. Lower rank = higher in the org (1 = executive). Rank is unique
/// per company so "rank 1" unambiguously means one level company-wide.
model PositionLevel {
  id              Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId        String?   @unique @map("legacy_id")
  companyId       Int       @map("company_id")
  companyIdLegacy String?   @map("company_id_legacy") @ignore
  code            String
  nameLao         String    @map("name_lao")
  nameEnglish     String?   @map("name_english")
  rank            Int
  description     String?
  status          OrgStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positions Position[]

  @@unique([companyId, code])
  @@unique([companyId, rank])
  @@index([companyId])
  @@map("position_levels")
}

model Position {
  id                    Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId              String?   @unique @map("legacy_id")
  companyId             Int       @map("company_id")
  companyIdLegacy       String?   @map("company_id_legacy") @ignore
  positionLevelId       Int?      @map("position_level_id")
  positionLevelIdLegacy String?   @map("position_level_id_legacy") @ignore
  code                  String
  nameLao               String    @map("name_lao")
  nameEnglish           String?   @map("name_english")
  description           String?
  status                OrgStatus @default(ACTIVE)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positionLevel     PositionLevel?              @relation(fields: [positionLevelId], references: [id], onDelete: SetNull)
  employees         Employee[]
  assignmentHistory EmployeeAssignmentHistory[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([positionLevelId])
  @@map("positions")
}

// Phase 3 — Employee Management. `Employee` (an HR personnel record) is a
// different concept from `User` (a login identity); they are linked by an
// OPTIONAL one-to-one `Employee.userId`. No salary/payroll/attendance fields.

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

model EmploymentType {
  id              Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId        String?   @unique @map("legacy_id")
  companyId       Int       @map("company_id")
  companyIdLegacy String?   @map("company_id_legacy") @ignore
  code            String
  nameLao         String    @map("name_lao")
  nameEnglish     String?   @map("name_english")
  description     String?
  status          OrgStatus @default(ACTIVE)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company   Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]
  history   EmployeeAssignmentHistory[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("employment_types")
}

model Employee {
  id           Int     @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId     String? @unique @map("legacy_id")
  employeeCode String  @unique @map("employee_code")
  userId       Int?    @unique @map("user_id")
  userIdLegacy String? @map("user_id_legacy") @ignore

  title            String?
  firstNameLao     String         @map("first_name_lao")
  lastNameLao      String         @map("last_name_lao")
  firstNameEnglish String?        @map("first_name_english")
  lastNameEnglish  String?        @map("last_name_english")
  nickname         String?
  gender           Gender?
  dateOfBirth      DateTime?      @map("date_of_birth") @db.Date
  nationalId       String?        @map("national_id")
  passportNumber   String?        @map("passport_number")
  maritalStatus    MaritalStatus? @map("marital_status")

  phone         String?
  personalEmail String? @map("personal_email")
  workEmail     String? @map("work_email")
  address       String?
  province      String?
  district      String?
  village       String?

  startDate              DateTime         @map("start_date") @db.Date
  probationEndDate       DateTime?        @map("probation_end_date") @db.Date
  endDate                DateTime?        @map("end_date") @db.Date
  employmentStatus       EmploymentStatus @default(ACTIVE) @map("employment_status")
  employmentTypeId       Int?             @map("employment_type_id")
  employmentTypeIdLegacy String?          @map("employment_type_id_legacy") @ignore

  // Current assignment snapshot — the source of truth for history is EmployeeAssignmentHistory.
  companyId               Int     @map("company_id")
  companyIdLegacy         String? @map("company_id_legacy") @ignore
  branchId                Int?    @map("branch_id")
  branchIdLegacy          String? @map("branch_id_legacy") @ignore
  departmentId            Int?    @map("department_id")
  departmentIdLegacy      String? @map("department_id_legacy") @ignore
  divisionId              Int?    @map("division_id")
  divisionIdLegacy        String? @map("division_id_legacy") @ignore
  unitId                  Int?    @map("unit_id")
  unitIdLegacy            String? @map("unit_id_legacy") @ignore
  positionId              Int?    @map("position_id")
  positionIdLegacy        String? @map("position_id_legacy") @ignore
  managerEmployeeId       Int?    @map("manager_employee_id")
  managerEmployeeIdLegacy String? @map("manager_employee_id_legacy") @ignore

  avatarUrl String?  @map("avatar_url")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  company        Company         @relation(fields: [companyId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  division       Division?       @relation(fields: [divisionId], references: [id])
  unit           Unit?           @relation(fields: [unitId], references: [id])
  position       Position?       @relation(fields: [positionId], references: [id])
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  manager        Employee?       @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  directReports  Employee[]      @relation("EmployeeManager")

  history          EmployeeAssignmentHistory[] @relation("HistoryEmployee")
  managedInHistory EmployeeAssignmentHistory[] @relation("HistoryManager")

  scheduleAssignments EmployeeScheduleAssignment[]

  attendanceRecords AttendanceRecord[]
  attendancePunches AttendancePunch[]

  correctionRequests AttendanceCorrectionRequest[]

  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  leaveRequestDays  LeaveRequestDay[]
  overtimeRequests  OvertimeRequest[]
  approvalInstances ApprovalInstance[]
  auditEvents       AuditEvent[]

  compensations              EmployeeCompensation[]
  recurringPay               EmployeeRecurringPayComponent[]
  payrollResults             PayrollEmployeeResult[]
  payrollAdjustments         PayrollManualAdjustment[]
  payrollScheduleMemberships PayrollScheduleEmployee[]
  statutoryProfile           EmployeeStatutoryProfile?
  payslips                   Payslip[]
  paymentProfile             EmployeePaymentProfile?
  bankAccounts               EmployeeBankAccount[]
  paymentItems               PayrollPaymentItem[]

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([divisionId])
  @@index([unitId])
  @@index([positionId])
  @@index([managerEmployeeId])
  @@index([employmentTypeId])
  @@index([employmentStatus])
  @@index([firstNameLao, lastNameLao])
  @@map("employees")
}

model EmployeeAssignmentHistory {
  id               Int     @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId         String? @unique @map("legacy_id")
  employeeId       Int     @map("employee_id")
  employeeIdLegacy String? @map("employee_id_legacy") @ignore

  companyId               Int     @map("company_id")
  companyIdLegacy         String? @map("company_id_legacy") @ignore
  branchId                Int?    @map("branch_id")
  branchIdLegacy          String? @map("branch_id_legacy") @ignore
  departmentId            Int?    @map("department_id")
  departmentIdLegacy      String? @map("department_id_legacy") @ignore
  divisionId              Int?    @map("division_id")
  divisionIdLegacy        String? @map("division_id_legacy") @ignore
  unitId                  Int?    @map("unit_id")
  unitIdLegacy            String? @map("unit_id_legacy") @ignore
  positionId              Int?    @map("position_id")
  positionIdLegacy        String? @map("position_id_legacy") @ignore
  managerEmployeeId       Int?    @map("manager_employee_id")
  managerEmployeeIdLegacy String? @map("manager_employee_id_legacy") @ignore
  employmentTypeId        Int?    @map("employment_type_id")
  employmentTypeIdLegacy  String? @map("employment_type_id_legacy") @ignore

  effectiveFrom         DateTime  @map("effective_from") @db.Date
  effectiveTo           DateTime? @map("effective_to") @db.Date
  reason                String?
  createdByUserId       Int?      @map("created_by_user_id")
  createdByUserIdLegacy String?   @map("created_by_user_id_legacy") @ignore
  createdAt             DateTime  @default(now()) @map("created_at")

  employee       Employee        @relation("HistoryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  company        Company         @relation(fields: [companyId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  department     Department?     @relation(fields: [departmentId], references: [id])
  division       Division?       @relation(fields: [divisionId], references: [id])
  unit           Unit?           @relation(fields: [unitId], references: [id])
  position       Position?       @relation(fields: [positionId], references: [id])
  manager        Employee?       @relation("HistoryManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  createdBy      User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("employee_assignment_history")
}

// Phase 4 — Shift, Holiday and Employee Work Schedule foundation. Configuration only:
// there is NO attendance/check-in data yet. Shift times are stored as "HH:mm" strings
// (wall-clock times in Asia/Vientiane, UTC+7) — never as timezone-shifted timestamps.

enum ShiftType {
  FIXED
  FLEXIBLE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HolidayType {
  PUBLIC
  COMPANY
}

model Shift {
  id              Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId        String?   @unique @map("legacy_id")
  companyId       Int       @map("company_id")
  companyIdLegacy String?   @map("company_id_legacy") @ignore
  code            String
  nameLao         String    @map("name_lao")
  nameEnglish     String?   @map("name_english")
  shiftType       ShiftType @default(FIXED) @map("shift_type")

  startTime       String  @map("start_time") @db.VarChar(5)
  endTime         String  @map("end_time") @db.VarChar(5)
  crossesMidnight Boolean @default(false) @map("crosses_midnight")

  breakMinutes           Int  @default(0) @map("break_minutes")
  lateGraceMinutes       Int  @default(0) @map("late_grace_minutes")
  earlyCheckInMinutes    Int? @map("early_check_in_minutes")
  earlyLeaveGraceMinutes Int  @default(0) @map("early_leave_grace_minutes")
  minimumWorkMinutes     Int? @map("minimum_work_minutes")

  status      OrgStatus @default(ACTIVE)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company     Company                      @relation(fields: [companyId], references: [id])
  workDays    ShiftWorkDay[]
  assignments EmployeeScheduleAssignment[]

  attendanceRecords AttendanceRecord[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("shifts")
}

model ShiftWorkDay {
  id                   Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId             String?   @unique @map("legacy_id")
  shiftId              Int       @map("shift_id")
  shiftIdLegacy        String?   @map("shift_id_legacy") @ignore
  dayOfWeek            DayOfWeek @map("day_of_week")
  isWorkingDay         Boolean   @default(true) @map("is_working_day")
  startTimeOverride    String?   @map("start_time_override") @db.VarChar(5)
  endTimeOverride      String?   @map("end_time_override") @db.VarChar(5)
  breakMinutesOverride Int?      @map("break_minutes_override")

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, dayOfWeek])
  @@map("shift_work_days")
}

model Holiday {
  id              Int         @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId        String?     @unique @map("legacy_id")
  companyId       Int         @map("company_id")
  companyIdLegacy String?     @map("company_id_legacy") @ignore
  nameLao         String      @map("name_lao")
  nameEnglish     String?     @map("name_english")
  holidayDate     DateTime    @map("holiday_date") @db.Date
  type            HolidayType @default(PUBLIC)
  isPaid          Boolean     @default(true) @map("is_paid")
  description     String?
  status          OrgStatus   @default(ACTIVE)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  attendanceRecords AttendanceRecord[]

  @@unique([companyId, holidayDate, nameLao])
  @@index([companyId, holidayDate])
  @@map("holidays")
}

model EmployeeScheduleAssignment {
  id                    Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId              String?   @unique @map("legacy_id")
  employeeId            Int       @map("employee_id")
  employeeIdLegacy      String?   @map("employee_id_legacy") @ignore
  shiftId               Int       @map("shift_id")
  shiftIdLegacy         String?   @map("shift_id_legacy") @ignore
  effectiveFrom         DateTime  @map("effective_from") @db.Date
  effectiveTo           DateTime? @map("effective_to") @db.Date
  reason                String?
  createdByUserId       Int?      @map("created_by_user_id")
  createdByUserIdLegacy String?   @map("created_by_user_id_legacy") @ignore
  createdAt             DateTime  @default(now()) @map("created_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift     Shift    @relation(fields: [shiftId], references: [id])
  createdBy User?    @relation("ScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
  @@map("employee_schedule_assignments")
}

// Phase 5 — Check-in / Check-out + attendance punch core. Two layers: AttendanceRecord (one
// summarized row per employee per scheduled WORK date, holding a schedule snapshot) and
// AttendancePunch (immutable raw events — never updated or deleted through the API).
// Punch instants are UTC, taken from the SERVER clock; Laos display is a presentation concern.

enum AttendanceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSING_CHECK_OUT
}

enum PunchType {
  CHECK_IN
  CHECK_OUT
}

enum PunchSource {
  WEB
  MOBILE_WEB
}

model WorkLocation {
  id              Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId        String?   @unique @map("legacy_id")
  companyId       Int       @map("company_id")
  companyIdLegacy String?   @map("company_id_legacy") @ignore
  branchId        Int?      @map("branch_id")
  branchIdLegacy  String?   @map("branch_id_legacy") @ignore
  code            String
  nameLao         String    @map("name_lao")
  nameEnglish     String?   @map("name_english")
  latitude        Float
  longitude       Float
  radiusMeters    Int       @map("radius_meters")
  requireGps      Boolean   @default(false) @map("require_gps")
  status          OrgStatus @default(ACTIVE)
  description     String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  company Company           @relation(fields: [companyId], references: [id])
  branch  Branch?           @relation(fields: [branchId], references: [id])
  punches AttendancePunch[]

  @@unique([companyId, code])
  @@index([companyId, branchId])
  @@map("work_locations")
}

model AttendanceRecord {
  id               Int      @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId         String?  @unique @map("legacy_id")
  employeeId       Int      @map("employee_id")
  employeeIdLegacy String?  @map("employee_id_legacy") @ignore
  /// The scheduled WORK day (an overnight shift's check-out on the next morning still belongs to it).
  workDate         DateTime @map("work_date") @db.Date

  scheduleAssignmentId            Int?    @map("schedule_assignment_id")
  scheduleAssignmentIdLegacy      String? @map("schedule_assignment_id_legacy") @ignore
  shiftId                         Int?    @map("shift_id")
  shiftIdLegacy                   String? @map("shift_id_legacy") @ignore
  scheduledStartTime              String? @map("scheduled_start_time") @db.VarChar(5)
  scheduledEndTime                String? @map("scheduled_end_time") @db.VarChar(5)
  scheduledBreakMinutes           Int?    @map("scheduled_break_minutes")
  scheduledCrossesMidnight        Boolean @default(false) @map("scheduled_crosses_midnight")
  /// Grace values are snapshotted too, so editing the Shift never changes historical Late/Early.
  scheduledLateGraceMinutes       Int?    @map("scheduled_late_grace_minutes")
  scheduledEarlyLeaveGraceMinutes Int?    @map("scheduled_early_leave_grace_minutes")

  // ---- EFFECTIVE / CALCULATED (cache). Raw facts stay in firstCheckInAt / lastCheckOutAt + punches. ----
  effectiveCheckInAt   DateTime?          @map("effective_check_in_at") @db.DateTime(3)
  effectiveCheckOutAt  DateTime?          @map("effective_check_out_at") @db.DateTime(3)
  isCorrected          Boolean            @default(false) @map("is_corrected")
  scheduledWorkMinutes Int?               @map("scheduled_work_minutes")
  workedMinutes        Int?               @map("worked_minutes")
  arrivalDelayMinutes  Int?               @map("arrival_delay_minutes")
  lateMinutes          Int?               @map("late_minutes")
  earlyLeaveMinutes    Int?               @map("early_leave_minutes")
  calculationStatus    CalculationStatus? @map("calculation_status")
  calculatedAt         DateTime?          @map("calculated_at") @db.DateTime(3)
  /// 0 = never calculated; 1 = Phase 6 formulas.
  calculationVersion   Int                @default(0) @map("calculation_version")

  firstCheckInAt DateTime? @map("first_check_in_at") @db.DateTime(3)
  lastCheckOutAt DateTime? @map("last_check_out_at") @db.DateTime(3)

  /// Stored: IN_PROGRESS | COMPLETED. NOT_STARTED / MISSING_CHECK_OUT are derived when presented.
  status          AttendanceStatus @default(NOT_STARTED)
  isWorkingDay    Boolean          @default(true) @map("is_working_day")
  isHoliday       Boolean          @default(false) @map("is_holiday")
  holidayId       Int?             @map("holiday_id")
  holidayIdLegacy String?          @map("holiday_id_legacy") @ignore

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee               Employee                          @relation(fields: [employeeId], references: [id])
  shift                  Shift?                            @relation(fields: [shiftId], references: [id])
  holiday                Holiday?                          @relation(fields: [holidayId], references: [id])
  punches                AttendancePunch[]
  correctionRequests     AttendanceCorrectionRequest[]
  correctionApplications AttendanceCorrectionApplication[]

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([employeeId, status])
  @@map("attendance_records")
}

model AttendancePunch {
  id                       Int         @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId                 String?     @unique @map("legacy_id")
  attendanceRecordId       Int         @map("attendance_record_id")
  attendanceRecordIdLegacy String?     @map("attendance_record_id_legacy") @ignore
  employeeId               Int         @map("employee_id")
  employeeIdLegacy         String?     @map("employee_id_legacy") @ignore
  type                     PunchType
  punchedAt                DateTime    @map("punched_at") @db.DateTime(3)
  source                   PunchSource

  latitude             Float?
  longitude            Float?
  accuracyMeters       Float?  @map("accuracy_meters")
  workLocationId       Int?    @map("work_location_id")
  workLocationIdLegacy String? @map("work_location_id_legacy") @ignore
  /// Snapshot: distance to the applicable work location and its radius AT PUNCH TIME.
  distanceMeters       Float?  @map("distance_meters")
  locationRadiusMeters Int?    @map("location_radius_meters")

  ipAddress             String?  @map("ip_address") @db.VarChar(64)
  userAgent             String?  @map("user_agent") @db.VarChar(255)
  createdByUserId       Int      @map("created_by_user_id")
  createdByUserIdLegacy String?  @map("created_by_user_id_legacy") @ignore
  createdAt             DateTime @default(now()) @map("created_at")

  record       AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id])
  workLocation WorkLocation?    @relation(fields: [workLocationId], references: [id])
  createdBy    User             @relation("PunchCreatedBy", fields: [createdByUserId], references: [id])

  @@index([attendanceRecordId, punchedAt])
  @@index([employeeId, punchedAt])
  @@map("attendance_punches")
}

// Phase 6 — attendance rules, calculation and corrections. Corrections NEVER touch AttendancePunch:
// an approved request produces an immutable AttendanceCorrectionApplication (the "effective overlay")
// and the record's cached effective/calculated fields are recalculated from it.

enum CalculationStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  LATE_AND_EARLY
  INCOMPLETE
}

enum CorrectionType {
  MISSING_CHECK_IN
  MISSING_CHECK_OUT
  TIME_ADJUSTMENT
  MISSING_BOTH
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AttendancePolicy {
  id                          Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId                    String?   @unique @map("legacy_id")
  companyId                   Int       @unique @map("company_id")
  companyIdLegacy             String?   @map("company_id_legacy") @ignore
  deductScheduledBreak        Boolean   @default(true) @map("deduct_scheduled_break")
  missingCheckOutGraceMinutes Int       @default(240) @map("missing_check_out_grace_minutes")
  allowEmployeeCorrection     Boolean   @default(true) @map("allow_employee_correction")
  correctionRequestWindowDays Int       @default(30) @map("correction_request_window_days")
  status                      OrgStatus @default(ACTIVE)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@map("attendance_policies")
}

model AttendanceCorrectionRequest {
  id                       Int              @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId                 String?          @unique @map("legacy_id")
  employeeId               Int              @map("employee_id")
  employeeIdLegacy         String?          @map("employee_id_legacy") @ignore
  attendanceRecordId       Int?             @map("attendance_record_id")
  attendanceRecordIdLegacy String?          @map("attendance_record_id_legacy") @ignore
  workDate                 DateTime         @map("work_date") @db.Date
  type                     CorrectionType
  requestedCheckInAt       DateTime?        @map("requested_check_in_at") @db.DateTime(3)
  requestedCheckOutAt      DateTime?        @map("requested_check_out_at") @db.DateTime(3)
  reason                   String           @db.Text
  status                   CorrectionStatus @default(PENDING)
  /// "employeeId:YYYY-MM-DD" while PENDING, NULL otherwise — a unique key enforcing one pending request per employee/day.
  pendingKey               String?          @unique @map("pending_key")

  requestedByUserId       Int       @map("requested_by_user_id")
  requestedByUserIdLegacy String?   @map("requested_by_user_id_legacy") @ignore
  reviewedByUserId        Int?      @map("reviewed_by_user_id")
  reviewedByUserIdLegacy  String?   @map("reviewed_by_user_id_legacy") @ignore
  reviewedAt              DateTime? @map("reviewed_at") @db.DateTime(3)
  reviewNote              String?   @map("review_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee    Employee                         @relation(fields: [employeeId], references: [id])
  record      AttendanceRecord?                @relation(fields: [attendanceRecordId], references: [id])
  requestedBy User                             @relation("CorrectionRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy  User?                            @relation("CorrectionReviewedBy", fields: [reviewedByUserId], references: [id])
  application AttendanceCorrectionApplication?

  @@index([employeeId, workDate])
  @@index([status, createdAt])
  @@map("attendance_correction_requests")
}

model AttendanceCorrectionApplication {
  id                        Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId                  String?   @unique @map("legacy_id")
  correctionRequestId       Int       @unique @map("correction_request_id")
  correctionRequestIdLegacy String?   @map("correction_request_id_legacy") @ignore
  attendanceRecordId        Int       @map("attendance_record_id")
  attendanceRecordIdLegacy  String?   @map("attendance_record_id_legacy") @ignore
  effectiveCheckInAt        DateTime? @map("effective_check_in_at") @db.DateTime(3)
  effectiveCheckOutAt       DateTime? @map("effective_check_out_at") @db.DateTime(3)
  appliedByUserId           Int       @map("applied_by_user_id")
  appliedByUserIdLegacy     String?   @map("applied_by_user_id_legacy") @ignore
  appliedAt                 DateTime  @default(now()) @map("applied_at") @db.DateTime(3)

  request   AttendanceCorrectionRequest @relation(fields: [correctionRequestId], references: [id])
  record    AttendanceRecord            @relation(fields: [attendanceRecordId], references: [id])
  appliedBy User                        @relation("CorrectionAppliedBy", fields: [appliedByUserId], references: [id])

  @@index([attendanceRecordId, appliedAt])
  @@map("attendance_correction_applications")
}

// ============================================================================================
// Phase 7 — Leave management (full-day only; dayValue is a Decimal so half-day can come later)
// ============================================================================================

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id                     Int       @id @default(autoincrement())
  /// M6: the pre-migration CUID (NULL for rows created after the numeric-ID migration); kept for M9 audit lookup
  legacyId               String?   @unique @map("legacy_id")
  companyId              Int       @map("company_id")
  companyIdLegacy        String?   @map("company_id_legacy") @ignore
  code                   String
  nameLao                String    @map("name_lao")
  nameEnglish            String?   @map("name_english")
  isPaid                 Boolean   @default(true) @map("is_paid")
  requiresBalance        Boolean   @default(true) @map("requires_balance")
  defaultEntitlementDays Decimal?  @map("default_entitlement_days") @db.Decimal(6, 2)
  minNoticeDays          Int       @default(0) @map("min_notice_days")
  maxConsecutiveDays     Int?      @map("max_consecutive_days")
  description            String?
  status                 OrgStatus @default(ACTIVE)
