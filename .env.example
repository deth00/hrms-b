PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Isolated MySQL database used only by `npm test` — never point this at a real/shared database.
TEST_DATABASE_URL=

SESSION_COOKIE_NAME=hr_session
SESSION_TTL_HOURS=12

# Only used by `npm run db:seed` to create the first administrator account.
# Leave blank to skip admin seeding. Never commit real values here.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=

# Attendance (Phase 5) — optional tuning; the defaults below apply when unset.
# Reject GPS fixes less precise than this (metres) when a work location requires GPS.
ATTENDANCE_MAX_GPS_ACCURACY_METERS=200
# Check-in window opens this many minutes before the shift starts (when the shift sets none).
ATTENDANCE_DEFAULT_EARLY_CHECK_IN_MINUTES=120
# After (scheduled end + this many hours) an unfinished record shows as MISSING_CHECK_OUT.
ATTENDANCE_CHECK_OUT_GRACE_HOURS=4

# Set to the number of reverse-proxy hops (e.g. 1) so the audit log records the real client IP. Leave unset when the API is exposed directly.
# TRUST_PROXY=1

# Phase 14 — employee bank-account numbers are encrypted with AES-256-GCM.
# 32 random bytes as 64 hex chars (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# REQUIRED in production (startup fails without it); an invalid value always fails startup.
# Never commit a real key. Keep older keys as BANK_ACCOUNT_ENCRYPTION_KEY_V<n> after a future rotation.
BANK_ACCOUNT_ENCRYPTION_KEY=
# BANK_ACCOUNT_ENCRYPTION_KEY_VERSION=1
